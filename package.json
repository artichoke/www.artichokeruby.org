{
  "name": "@artichokeruby/www.artichokeruby.org",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Artichoke project website",
  "keywords": [
    "programming language",
    "scripting",
    "ruby",
    "rust",
    "wasm"
  ],
  "homepage": "https://www.artichokeruby.org",
  "bugs": "https://github.com/artichoke/www.artichokeruby.org/issues",
  "license": "MIT",
  "author": "Ryan Lopopolo <rjl@hyperbo.la> (https://hyperbo.la/)",
  "contributors": [
    "Ryan Lopopolo <rjl@hyperbo.la> (https://hyperbo.la/)"
  ],
  "repository": "github:artichoke/www.artichokeruby.org",
  "dependencies": {
    "@artichokeruby/logo": "^0.12.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.9",
    "eslint": "9.34.0",
    "eta": "^3.5.0",
    "globals": "^16.3.0",
    "highlight.js": "^11.11.1",
    "prettier": "3.6.2",
    "rimraf": "^6.0.1"
  },
  "scripts": {
    "dev": "concurrently \"npm:serve\" \"npm:watch\"",
    "build": "node build.mjs",
    "serve": "python3 -u -m http.server --directory dist --bind localhost 0",
    "watch": "chokidar \"package.json\" \"package-lock.json\" \"build.mjs\" \"src/**/*\" -c \"npm run build\" --initial",
    "clean": "rimraf dist",
    "fmt": "prettier --write \"**/*\"",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  }
}
